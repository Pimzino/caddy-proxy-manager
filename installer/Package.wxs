<?xml version="1.0" encoding="utf-8"?>
<!--
  Caddy Proxy Manager - per-machine MSI.

  Installs the self-contained single-file CaddyManager.exe to "C:\Program Files\Caddy Proxy Manager",
  registers the Windows service "CaddyProxyManager" (LocalSystem, automatic delayed start, restart on failure),
  opens the management UI port in Windows Defender Firewall and starts the service. The service installs
  Caddy itself (service "Caddy") on first start.

  Public properties:
    UI_PORT   TCP port of the management UI (default: keep the configured port; 81 on a new install).
              msiexec /i CaddyProxyManager-1.0.0-x64.msi UI_PORT=8081 /qn
              The port is remembered (HKLM\SOFTWARE\Caddy Proxy Manager\UiPort) so upgrades keep the firewall
              exception and the Start-menu shortcut on the same port.
    BIND      IP address the management UI listens on (default: keep the configured address; 0.0.0.0 = all interfaces
              on a new install). 127.0.0.1 = this server only. Must be an address of this server, otherwise the
              installation fails and rolls back (see the MSI log: msiexec /i ... /l*v install.log).
              msiexec /i CaddyProxyManager-1.0.0-x64.msi BIND=127.0.0.1 /qn

  UI: a short wizard (Welcome → Ready to install → progress → Finish) without a license page. The Finish page is tailored
  to what the run did (new install, upgrade, reinstall over kept data, repair, removal): how to open the UI, where the
  first-run setup token is when setup is still pending, and an option to open the UI in the browser. Silent installs (/qn, /quiet) show no UI and are unchanged.
  A Start-menu shortcut "Caddy Proxy Manager" opens http://localhost:<port>/ (http://<BIND>:<port>/ when the UI is bound to
  one specific IPv4 address).

  Every install/upgrade runs "CaddyManager.exe configure" (deferred, as LocalSystem) before the service starts: it
  creates C:\ProgramData\CaddyProxyManager, restricts it to SYSTEM + Administrators and stores UI_PORT / BIND when given.

  Uninstall removes the manager service, the firewall exception, the Start-menu shortcut, the Caddy service, the
  firewall rules of the "Caddy Proxy Manager" group and the "Caddy Proxy Manager" event log source (via
  "CaddyManager.exe uninstall-caddy-service"). Data in C:\ProgramData\CaddyProxyManager is kept.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Caddy Proxy Manager"
           Manufacturer="Caddy Proxy Manager"
           Version="$(var.ProductVersion)"
           UpgradeCode="E8291510-81A8-4EE4-9ED4-3AA76CCF2109"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500"
           Language="1033">

    <SummaryInformation Description="Caddy Proxy Manager $(var.ProductVersion)" Manufacturer="Caddy Proxy Manager" />

    <!-- AllowSameVersionUpgrades: CI builds (1.0.0-ci.N) share the MSI version 1.0.0 and must still replace each other. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first to downgrade." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />
    <!-- VersionNT cannot tell these apart: Windows 8.1 / Server 2012 R2 report 603, and so do Windows 10 / 11 and Server
         2016-2025 (Windows Installer reports 603 on later versions too), https://learn.microsoft.com/en-us/windows/win32/msi/operating-system-property-values
         The real build number comes from the registry (REG_SZ, e.g. "17763"); a property that converts to an integer is
         compared numerically (https://learn.microsoft.com/en-us/windows/win32/msi/conditional-statement-syntax).
         17763 = Windows 10 1809 / Windows Server 2019. -->
    <Property Id="CPM_OSBUILD">
      <RegistrySearch Id="OsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR CPM_OSBUILD &gt;= 17763" Message="[ProductName] requires 64-bit Windows 10 1809 / Windows Server 2019 or later (this is build [CPM_OSBUILD])." />
    <Launch Condition="Privileged" Message="[ProductName] must be installed by an administrator." />

    <!-- ===================================================================== properties -->
    <!-- UI_PORT / BIND given on the command line reconfigure the UI listener; otherwise the stored settings are kept. -->
    <Property Id="UI_PORT" Secure="yes" />
    <Property Id="BIND" Secure="yes" />
    <!-- Port of the firewall exception: UI_PORT, else the port remembered by a previous install, else 81. -->
    <Property Id="CPM_SAVED_UI_PORT" Secure="yes">
      <RegistrySearch Id="SavedUiPortSearch" Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiPort" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CPM_FIREWALL_PORT" Value="81" Secure="yes" />
    <SetProperty Id="CPM_FIREWALL_PORT" Action="CPM_SetFirewallPortFromSaved" Value="[CPM_SAVED_UI_PORT]" After="AppSearch" Sequence="both"
                 Condition="CPM_SAVED_UI_PORT AND NOT UI_PORT" />
    <SetProperty Id="CPM_FIREWALL_PORT" Action="CPM_SetFirewallPortFromUiPort" Value="[UI_PORT]" After="AppSearch" Sequence="both"
                 Condition="UI_PORT" />

    <!-- Host name for the Start-menu shortcut and the Finish page: localhost, unless the UI is bound to one specific IPv4
         address (BIND, else the address remembered by a previous install); localhost would not reach it then. -->
    <Property Id="CPM_SAVED_UI_BIND" Secure="yes">
      <RegistrySearch Id="SavedUiBindSearch" Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiBind" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CPM_UI_BIND" Action="CPM_SetUiBindFromSaved" Value="[CPM_SAVED_UI_BIND]" After="AppSearch" Sequence="both"
                 Condition="CPM_SAVED_UI_BIND AND NOT BIND" />
    <SetProperty Id="CPM_UI_BIND" Action="CPM_SetUiBindFromBind" Value="[BIND]" After="CPM_SetUiBindFromSaved" Sequence="both"
                 Condition="BIND" />
    <!-- First-run setup already done on this server (the manager writes this DWORD; it survives an uninstall that keeps
         the data folder, and uninstall -purge removes it). Raw DWORD values read as "#1". -->
    <Property Id="CPM_SETUP_DONE" Secure="yes">
      <RegistrySearch Id="SetupDoneSearch" Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="SetupCompleted" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CPM_UI_HOST" Value="localhost" Secure="yes" />
    <SetProperty Id="CPM_UI_HOST" Action="CPM_SetUiHost" Value="[CPM_UI_BIND]" After="CPM_SetUiBindFromBind" Sequence="both"
                 Condition="CPM_UI_BIND AND NOT (CPM_UI_BIND &gt;&lt; &quot;:&quot;) AND CPM_UI_BIND &lt;&gt; &quot;0.0.0.0&quot; AND NOT (CPM_UI_BIND &lt;&lt; &quot;127.&quot;)" />

    <!-- Branding: the product icon (same file as the exe's ApplicationIcon) and the wizard artwork, all rendered by
         docs/brand/logo-concepts/generate.ts assets. Dialog bitmap 493×312 (welcome/finish), banner 493×58. -->
    <Icon Id="CaddyProxyManager.ico" SourceFile="$(var.RepoRoot)\src\CaddyManager\app.ico" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.RepoRoot)\installer\assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.RepoRoot)\installer\assets\banner.bmp" />

    <!-- Add/Remove Programs -->
    <Property Id="ARPPRODUCTICON" Value="CaddyProxyManager.ico" />
    <Property Id="ARPCOMMENTS" Value="Web UI to install, configure and monitor the Caddy web server / reverse proxy on Windows Server." />
    <Property Id="ARPCONTACT" Value="Caddy Proxy Manager" />
    <Property Id="ARPHELPTEXT" Value="Open the web UI on the server (http://localhost:81/ unless UI_PORT was changed). First-run setup token: C:\ProgramData\CaddyProxyManager\setup-token.txt" />
    <Property Id="ARPURLINFOABOUT" Value="http://localhost:81/" />
    <SetProperty Id="ARPURLINFOABOUT" Action="CPM_SetArpUrl" Value="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/" After="CostFinalize" Sequence="execute" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />

    <!-- ===================================================================== files + service -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Caddy Proxy Manager" />
    </StandardDirectory>
    <!-- All-users Start menu (per-machine package). The shortcut's component lives in INSTALLFOLDER (HKLM key path), the
         .url file itself is created in the Start menu by the util extension and removed on uninstall. -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ManagerExecutable">
        <File Id="CaddyManagerExe" Source="$(var.PublishDir)\CaddyManager.exe" KeyPath="yes" />

        <ServiceInstall Id="ManagerServiceInstall"
                        Name="CaddyProxyManager"
                        DisplayName="Caddy Proxy Manager"
                        Description="Caddy Proxy Manager: web UI that installs, configures and monitors the Caddy web server / reverse proxy."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Automatic (Delayed Start) and "run recovery actions also on a non-zero exit code" are applied by the
               CPM_ConfigureService custom action (the core ServiceConfig / MsiServiceConfig table is unreliable, WIX1149).
               Restart on failure (baseline; CPM_ConfigureService sets 5s / 10s / 30s), reset the failure counter after 1 day.
               CPM_ConfigureService is sequenced after Wix4SchedServiceConfig (below), so its values are the ones that stay. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ManagerServiceControl" Name="CaddyProxyManager" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <fire:FirewallException Id="ManagementUiFirewall"
                                Name="Caddy Proxy Manager - Management UI (TCP-In)"
                                Description="Allows inbound TCP to the Caddy Proxy Manager web UI. Created by the Caddy Proxy Manager installer."
                                Grouping="Caddy Proxy Manager"
                                Port="[CPM_FIREWALL_PORT]"
                                Protocol="tcp"
                                Scope="any"
                                Profile="all"
                                IgnoreFailure="yes" />
      </Component>

      <!-- The publish output is the single CaddyManager.exe (settings live in the database, not in appsettings.json). -->
      <!-- License of this project and notices of bundled third-party components (the fonts' OFL requires it). -->
      <!-- One unversioned file per component so WiX can generate stable component GUIDs. -->
      <Component Id="LicenseFile">
        <File Id="LicenseFile" Source="$(var.RepoRoot)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNotices">
        <File Id="ThirdPartyNotices" Source="$(var.RepoRoot)\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>

      <Component Id="RememberUiPort">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiPort" Type="string" Value="[CPM_FIREWALL_PORT]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiBind" Type="string" Value="[CPM_UI_BIND]" />
      </Component>

      <!-- Start menu: "Caddy Proxy Manager" opens the web UI on this server. -->
      <Component Id="StartMenuShortcut">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <util:InternetShortcut Id="WebUiShortcut"
                               Directory="ProgramMenuFolder"
                               Name="Caddy Proxy Manager"
                               Target="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/"
                               Type="url" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Caddy Proxy Manager" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- ===================================================================== custom actions -->
    <!-- WixQuietExec from the native custom action DLL of the package's platform (Wix4UtilCA_X64). WixQuietExec64 is a
         32-bit custom action that "will be removed in the next major version of WiX":
         https://github.com/wixtoolset/web/blob/master/src/Docusaurus/docs/tools/wixext/quietexec.md
         Deferred: the command line is the value of the property with the same Id as the custom action. -->
    <!-- Before the service starts: create + lock down the data directory, and store UI_PORT / BIND when given.
         "configure" rejects a BIND that is not an address of this server; Return="check" then rolls the install back. -->
    <SetProperty Id="CPM_CFG_PORT_ARG" Action="CPM_SetConfigurePortArg" Value="--ui-port [UI_PORT]"
                 Before="CPM_SetConfigureUiCommand" Sequence="execute"
                 Condition="UI_PORT AND NOT (REMOVE=&quot;ALL&quot;)" />
    <SetProperty Id="CPM_CFG_BIND_ARG" Action="CPM_SetConfigureBindArg" Value="--bind [BIND]"
                 Before="CPM_SetConfigureUiCommand" Sequence="execute"
                 Condition="BIND AND NOT (REMOVE=&quot;ALL&quot;)" />
    <SetProperty Id="CPM_ConfigureUi" Action="CPM_SetConfigureUiCommand"
                 Value="&quot;[#CaddyManagerExe]&quot; configure [CPM_CFG_PORT_ARG] [CPM_CFG_BIND_ARG]"
                 Before="CPM_ConfigureUi" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    <CustomAction Id="CPM_ConfigureUi"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- On a real uninstall (not a major upgrade) also stop and delete the "Caddy" service the manager created, the
         firewall rules of the "Caddy Proxy Manager" group created by readiness fixes and the event log source. -->
    <SetProperty Id="CPM_RemoveCaddyService"
                 Value="&quot;[#CaddyManagerExe]&quot; uninstall-caddy-service"
                 Before="CPM_RemoveCaddyService" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="CPM_RemoveCaddyService"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- After the service is registered and before it starts: delayed start, recovery actions, failure-actions flag. -->
    <SetProperty Id="CPM_ConfigureService"
                 Value="&quot;[#CaddyManagerExe]&quot; configure-service"
                 Before="CPM_ConfigureService" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    <CustomAction Id="CPM_ConfigureService"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- ===================================================================== wizard UI -->
    <!-- What the Finish page says depends on what this run did (CPM_OUTCOME), decided from three signals read before the
         wizard starts: Installed (this exact product is installed: maintenance), WIX_UPGRADE_DETECTED (an earlier version
         is installed: MajorUpgrade's FindRelatedProducts) and CPM_SETUP_DONE (first-run setup was completed on this
         server: HKLM\SOFTWARE\Caddy Proxy Manager\SetupCompleted, written by the manager, kept across uninstalls that
         keep the data folder). Repair / Remove are set by the maintenance buttons below.
           Fresh            new install, never set up         → open the UI, create the first administrator (token)
           UpgradeNotSetUp  upgrade, setup never finished     → open the UI, finish setup (token)
           Upgrade          upgrade of a server in use        → open the UI, sign in as before
           Reinstall        new install over kept data        → open the UI, sign in with the existing accounts
           Repair / Remove  maintenance                       → what was restored / removed, and that data is kept -->
    <SetProperty Id="CPM_OUTCOME" Action="CPM_SetOutcomeFresh" Value="Fresh" After="CostFinalize" Sequence="ui"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT CPM_SETUP_DONE" />
    <SetProperty Id="CPM_OUTCOME" Action="CPM_SetOutcomeReinstall" Value="Reinstall" After="CPM_SetOutcomeFresh" Sequence="ui"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND CPM_SETUP_DONE" />
    <SetProperty Id="CPM_OUTCOME" Action="CPM_SetOutcomeUpgrade" Value="Upgrade" After="CPM_SetOutcomeReinstall" Sequence="ui"
                 Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND CPM_SETUP_DONE" />
    <SetProperty Id="CPM_OUTCOME" Action="CPM_SetOutcomeUpgradeNotSetUp" Value="UpgradeNotSetUp" After="CPM_SetOutcomeUpgrade" Sequence="ui"
                 Condition="NOT Installed AND WIX_UPGRADE_DETECTED AND NOT CPM_SETUP_DONE" />

    <!-- "Open the web UI in my browser now" (checked by default). WixShellExec runs in the wizard's client process, i.e. as
         the signed-in user, not elevated. -->
    <Property Id="CPM_OPEN_UI" Value="1" />
    <CustomAction Id="CPM_OpenWebUi" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <!-- Minimal wizard without a license page, built from the WixUI dialog library (WixToolset.UI.wixext):
         WelcomeDlg → VerifyReadyDlg → ProgressDlg → CPM_FinishDlg; maintenance mode offers Repair / Remove. -->
    <UI Id="CPM_WixUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <!-- Finish page: the web UI's ink / muted / teal (web/src/index.css) -->
      <TextStyle Id="CPM_Finish_Title" FaceName="Segoe UI" Size="13" Bold="yes" Red="15" Green="23" Blue="42" />
      <TextStyle Id="CPM_Finish_Body" FaceName="Segoe UI" Size="9" Red="15" Green="23" Blue="42" />
      <TextStyle Id="CPM_Finish_Muted" FaceName="Segoe UI" Size="9" Red="71" Green="85" Blue="105" />
      <TextStyle Id="CPM_Finish_Heading" FaceName="Segoe UI" Size="9" Bold="yes" Red="15" Green="118" Blue="110" />
      <!-- 8 pt: the 48-character setup-token path must fit the 222-unit text column without Windows eliding its middle -->
      <TextStyle Id="CPM_Finish_Mono" FaceName="Consolas" Size="8" Red="15" Green="23" Blue="42" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <!-- Finish page (replaces WixUI's ExitDialog): same frame and 493×312 artwork (WixUIDialogBmp) as the welcome page. -->
      <Dialog Id="CPM_FinishDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Property="WixShellExecTarget" Value="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/" Order="1" Condition='CPM_OPEN_UI = 1 AND NOT (CPM_OUTCOME = "Remove")' />
          <Publish Event="DoAction" Value="CPM_OpenWebUi" Order="2" Condition='CPM_OPEN_UI = 1 AND NOT (CPM_OUTCOME = "Remove")' />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&lt; &amp;Back" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="TitleInstalled" Type="Text" X="135" Y="18" Width="222" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Title}Caddy Proxy Manager is installed" ShowCondition='CPM_OUTCOME = "Fresh" OR CPM_OUTCOME = "Reinstall"' />
        <Control Id="TitleUpdated" Type="Text" X="135" Y="18" Width="222" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Title}Caddy Proxy Manager is updated" ShowCondition='CPM_OUTCOME = "Upgrade" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="TitleRepaired" Type="Text" X="135" Y="18" Width="222" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Title}Caddy Proxy Manager is repaired" ShowCondition='CPM_OUTCOME = "Repair"' />
        <Control Id="TitleRemoved" Type="Text" X="135" Y="18" Width="222" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Title}Caddy Proxy Manager was removed" ShowCondition='CPM_OUTCOME = "Remove"' />
        <Control Id="TitleDone" Type="Text" X="135" Y="18" Width="222" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Title}Setup is complete" ShowCondition="NOT CPM_OUTCOME" />
        <Control Id="SubFresh" Type="Text" X="135" Y="40" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}The service is running and starts with Windows." ShowCondition='CPM_OUTCOME = "Fresh"' />
        <Control Id="SubUpgrade" Type="Text" X="135" Y="40" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}Your hosts, certificates and settings were kept, and the service has restarted." ShowCondition='CPM_OUTCOME = "Upgrade" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="SubReinstall" Type="Text" X="135" Y="40" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}The configuration from the previous installation was found and kept." ShowCondition='CPM_OUTCOME = "Reinstall"' />
        <Control Id="SubRepair" Type="Text" X="135" Y="40" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}Program files, the service and the firewall exception were restored. Your configuration was not changed." ShowCondition='CPM_OUTCOME = "Repair"' />
        <Control Id="SubRemove" Type="Text" X="135" Y="40" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}The manager and Caddy services, their firewall rules and the Start-menu shortcut were removed." ShowCondition='CPM_OUTCOME = "Remove"' />
        <Control Id="HeadOpenNumbered" Type="Text" X="135" Y="72" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Heading}1 · Open the web UI" ShowCondition='CPM_OUTCOME = "Fresh" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="HeadOpen" Type="Text" X="135" Y="72" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Heading}Open the web UI" ShowCondition='CPM_OUTCOME = "Upgrade" OR CPM_OUTCOME = "Reinstall" OR CPM_OUTCOME = "Repair" OR NOT CPM_OUTCOME' />
        <Control Id="Link" Type="Hyperlink" X="135" Y="85" Width="222" Height="12" Transparent="yes" Hidden="yes"
                 Text='&lt;a href="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/"&gt;http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/&lt;/a&gt;' ShowCondition='NOT (CPM_OUTCOME = "Remove")' />
        <Control Id="SignInBefore" Type="Text" X="135" Y="99" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Body}Sign in as before." ShowCondition='CPM_OUTCOME = "Upgrade" OR CPM_OUTCOME = "Repair"' />
        <Control Id="SignInExisting" Type="Text" X="135" Y="99" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Body}Sign in with your existing accounts." ShowCondition='CPM_OUTCOME = "Reinstall"' />
        <Control Id="HeadAdmin" Type="Text" X="135" Y="114" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Heading}2 · Create the first administrator" ShowCondition='CPM_OUTCOME = "Fresh"' />
        <Control Id="HeadFinishSetup" Type="Text" X="135" Y="114" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Heading}2 · Finish the first-run setup" ShowCondition='CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="TokenIntro" Type="Text" X="135" Y="127" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Body}Use the one-time setup token in" ShowCondition='CPM_OUTCOME = "Fresh" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="TokenPath" Type="Text" X="135" Y="140" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Mono}C:\ProgramData\CaddyProxyManager\setup-token.txt" ShowCondition='CPM_OUTCOME = "Fresh" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="TokenNote" Type="Text" X="135" Y="153" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}(readable from an elevated prompt)" ShowCondition='CPM_OUTCOME = "Fresh" OR CPM_OUTCOME = "UpgradeNotSetUp"' />
        <Control Id="HeadKept" Type="Text" X="135" Y="72" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Heading}Your data was kept" ShowCondition='CPM_OUTCOME = "Remove"' />
        <Control Id="KeptIntro" Type="Text" X="135" Y="85" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Body}Configuration, certificates and backups remain in" ShowCondition='CPM_OUTCOME = "Remove"' />
        <Control Id="KeptPath" Type="Text" X="135" Y="98" Width="222" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Mono}C:\ProgramData\CaddyProxyManager" ShowCondition='CPM_OUTCOME = "Remove"' />
        <Control Id="KeptNote" Type="Text" X="135" Y="112" Width="222" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Muted}Reinstall to pick up where you left off, or delete the folder to remove everything." ShowCondition='CPM_OUTCOME = "Remove"' />
        <!-- A CheckBox control paints an opaque (grey) background, so it is only as wide as the box itself; the label is a
             separate transparent Text control. -->
        <Control Id="OpenUi" Type="CheckBox" X="135" Y="213" Width="11" Height="11" Property="CPM_OPEN_UI" CheckBoxValue="1" Hidden="yes"
                 ShowCondition="NOT (CPM_OUTCOME = &quot;Remove&quot;)" />
        <Control Id="OpenUiLabel" Type="Text" X="149" Y="212" Width="208" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\CPM_Finish_Body}Open the web UI in my browser now" ShowCondition="NOT (CPM_OUTCOME = &quot;Remove&quot;)" />
      </Dialog>
      <InstallUISequence>
        <Show Dialog="CPM_FinishDlg" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="CPM_FinishDlg" OnExit="success" />
      </AdminUISequence>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Property="CPM_OUTCOME" Value="Repair" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Property="CPM_OUTCOME" Value="Remove" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <InstallExecuteSequence>
      <!-- util:ServiceConfig schedules its deferred ExecServiceConfig from Wix4SchedServiceConfig, which is also sequenced
           After="InstallServices" (UtilExtension_Platform.wxi, WiX v6.0.2). Sequencing after it guarantees that
           configure-service writes the final recovery actions (5 s / 10 s / 30 s) instead of the baseline. -->
      <Custom Action="CPM_ConfigureService" After="Wix4SchedServiceConfig_$(sys.BUILDARCHSHORT)" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="CPM_ConfigureUi" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="CPM_RemoveCaddyService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
