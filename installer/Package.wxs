<?xml version="1.0" encoding="utf-8"?>
<!--
  Caddy Proxy Manager - per-machine MSI.

  Installs the self-contained single-file CaddyManager.exe to "C:\Program Files\Caddy Proxy Manager",
  registers the Windows service "CaddyProxyManager" (LocalSystem, automatic delayed start, restart on failure),
  opens the management UI port in Windows Defender Firewall and starts the service. The service installs
  Caddy itself (service "Caddy") on first start.

  Public properties:
    UI_PORT   TCP port of the management UI (default: keep the configured port; 81 on a new install).
              msiexec /i CaddyProxyManager-1.0.0-x64.msi UI_PORT=8081 /qn
              The port is remembered (HKLM\SOFTWARE\Caddy Proxy Manager\UiPort) so upgrades keep the firewall
              exception and the Start-menu shortcut on the same port.
    BIND      IP address the management UI listens on (default: keep the configured address; 0.0.0.0 = all interfaces
              on a new install). 127.0.0.1 = this server only. Must be an address of this server, otherwise the
              installation fails and rolls back (see the MSI log: msiexec /i ... /l*v install.log).
              msiexec /i CaddyProxyManager-1.0.0-x64.msi BIND=127.0.0.1 /qn

  UI: a short wizard (Welcome → Ready to install → progress → Finish) without a license page. The Finish page explains
  how to open the UI and where the first-run setup token is. Silent installs (/qn, /quiet) show no UI and are unchanged.
  A Start-menu shortcut "Caddy Proxy Manager" opens http://localhost:<port>/ (http://<BIND>:<port>/ when the UI is bound to
  one specific IPv4 address).

  Every install/upgrade runs "CaddyManager.exe configure" (deferred, as LocalSystem) before the service starts: it
  creates C:\ProgramData\CaddyProxyManager, restricts it to SYSTEM + Administrators and stores UI_PORT / BIND when given.

  Uninstall removes the manager service, the firewall exception, the Start-menu shortcut, the Caddy service, the
  firewall rules of the "Caddy Proxy Manager" group and the "Caddy Proxy Manager" event log source (via
  "CaddyManager.exe uninstall-caddy-service"). Data in C:\ProgramData\CaddyProxyManager is kept.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Caddy Proxy Manager"
           Manufacturer="Caddy Proxy Manager"
           Version="$(var.ProductVersion)"
           UpgradeCode="E8291510-81A8-4EE4-9ED4-3AA76CCF2109"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500"
           Language="1033">

    <SummaryInformation Description="Caddy Proxy Manager $(var.ProductVersion)" Manufacturer="Caddy Proxy Manager" />

    <!-- AllowSameVersionUpgrades: CI builds (1.0.0-ci.N) share the MSI version 1.0.0 and must still replace each other. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first to downgrade." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="VersionNT64" Message="[ProductName] requires 64-bit Windows." />
    <Launch Condition="Installed OR VersionNT &gt;= 603" Message="[ProductName] requires Windows Server 2016 or later (Windows Server 2025 recommended)." />
    <Launch Condition="Privileged" Message="[ProductName] must be installed by an administrator." />

    <!-- ===================================================================== properties -->
    <!-- UI_PORT / BIND given on the command line reconfigure the UI listener; otherwise the stored settings are kept. -->
    <Property Id="UI_PORT" Secure="yes" />
    <Property Id="BIND" Secure="yes" />
    <!-- Port of the firewall exception: UI_PORT, else the port remembered by a previous install, else 81. -->
    <Property Id="CPM_SAVED_UI_PORT" Secure="yes">
      <RegistrySearch Id="SavedUiPortSearch" Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiPort" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CPM_FIREWALL_PORT" Value="81" Secure="yes" />
    <SetProperty Id="CPM_FIREWALL_PORT" Action="CPM_SetFirewallPortFromSaved" Value="[CPM_SAVED_UI_PORT]" After="AppSearch" Sequence="both"
                 Condition="CPM_SAVED_UI_PORT AND NOT UI_PORT" />
    <SetProperty Id="CPM_FIREWALL_PORT" Action="CPM_SetFirewallPortFromUiPort" Value="[UI_PORT]" After="AppSearch" Sequence="both"
                 Condition="UI_PORT" />

    <!-- Host name for the Start-menu shortcut and the Finish page: localhost, unless the UI is bound to one specific IPv4
         address (BIND, else the address remembered by a previous install); localhost would not reach it then. -->
    <Property Id="CPM_SAVED_UI_BIND" Secure="yes">
      <RegistrySearch Id="SavedUiBindSearch" Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiBind" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CPM_UI_BIND" Action="CPM_SetUiBindFromSaved" Value="[CPM_SAVED_UI_BIND]" After="AppSearch" Sequence="both"
                 Condition="CPM_SAVED_UI_BIND AND NOT BIND" />
    <SetProperty Id="CPM_UI_BIND" Action="CPM_SetUiBindFromBind" Value="[BIND]" After="CPM_SetUiBindFromSaved" Sequence="both"
                 Condition="BIND" />
    <Property Id="CPM_UI_HOST" Value="localhost" Secure="yes" />
    <SetProperty Id="CPM_UI_HOST" Action="CPM_SetUiHost" Value="[CPM_UI_BIND]" After="CPM_SetUiBindFromBind" Sequence="both"
                 Condition="CPM_UI_BIND AND NOT (CPM_UI_BIND &gt;&lt; &quot;:&quot;) AND CPM_UI_BIND &lt;&gt; &quot;0.0.0.0&quot; AND NOT (CPM_UI_BIND &lt;&lt; &quot;127.&quot;)" />

    <!-- Add/Remove Programs -->
    <Property Id="ARPCOMMENTS" Value="Web UI to install, configure and monitor the Caddy web server / reverse proxy on Windows Server." />
    <Property Id="ARPCONTACT" Value="Caddy Proxy Manager" />
    <Property Id="ARPHELPTEXT" Value="Open the web UI on the server (http://localhost:81/ unless UI_PORT was changed). First-run setup token: C:\ProgramData\CaddyProxyManager\setup-token.txt" />
    <Property Id="ARPURLINFOABOUT" Value="http://localhost:81/" />
    <SetProperty Id="ARPURLINFOABOUT" Action="CPM_SetArpUrl" Value="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/" After="CostFinalize" Sequence="execute" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />

    <!-- ===================================================================== files + service -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Caddy Proxy Manager" />
    </StandardDirectory>
    <!-- All-users Start menu (per-machine package). The shortcut's component lives in INSTALLFOLDER (HKLM key path), the
         .url file itself is created in the Start menu by the util extension and removed on uninstall. -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="ManagerExecutable">
        <File Id="CaddyManagerExe" Source="$(var.PublishDir)\CaddyManager.exe" KeyPath="yes" />

        <ServiceInstall Id="ManagerServiceInstall"
                        Name="CaddyProxyManager"
                        DisplayName="Caddy Proxy Manager"
                        Description="Caddy Proxy Manager: web UI that installs, configures and monitors the Caddy web server / reverse proxy."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Automatic (Delayed Start) and "run recovery actions also on a non-zero exit code" are applied by the
               CPM_ConfigureService custom action (the core ServiceConfig / MsiServiceConfig table is unreliable, WIX1149).
               Restart on failure (baseline; CPM_ConfigureService sets 5s / 10s / 30s), reset the failure counter after 1 day. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ManagerServiceControl" Name="CaddyProxyManager" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <fire:FirewallException Id="ManagementUiFirewall"
                                Name="Caddy Proxy Manager - Management UI (TCP-In)"
                                Description="Allows inbound TCP to the Caddy Proxy Manager web UI. Created by the Caddy Proxy Manager installer."
                                Grouping="Caddy Proxy Manager"
                                Port="[CPM_FIREWALL_PORT]"
                                Protocol="tcp"
                                Scope="any"
                                Profile="all"
                                IgnoreFailure="yes" />
      </Component>

      <!-- The publish output is the single CaddyManager.exe (settings live in the database, not in appsettings.json). -->
      <Component Id="RememberUiPort">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiPort" Type="string" Value="[CPM_FIREWALL_PORT]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="UiBind" Type="string" Value="[CPM_UI_BIND]" />
      </Component>

      <!-- Start menu: "Caddy Proxy Manager" opens the web UI on this server. -->
      <Component Id="StartMenuShortcut">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Caddy Proxy Manager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <util:InternetShortcut Id="WebUiShortcut"
                               Directory="ProgramMenuFolder"
                               Name="Caddy Proxy Manager"
                               Target="http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/"
                               Type="url" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Caddy Proxy Manager" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- ===================================================================== custom actions -->
    <!-- Before the service starts: create + lock down the data directory, and store UI_PORT / BIND when given.
         "configure" rejects a BIND that is not an address of this server; Return="check" then rolls the install back. -->
    <SetProperty Id="CPM_CFG_PORT_ARG" Action="CPM_SetConfigurePortArg" Value="--ui-port [UI_PORT]"
                 Before="CPM_SetConfigureUiCommand" Sequence="execute"
                 Condition="UI_PORT AND NOT (REMOVE=&quot;ALL&quot;)" />
    <SetProperty Id="CPM_CFG_BIND_ARG" Action="CPM_SetConfigureBindArg" Value="--bind [BIND]"
                 Before="CPM_SetConfigureUiCommand" Sequence="execute"
                 Condition="BIND AND NOT (REMOVE=&quot;ALL&quot;)" />
    <SetProperty Id="CPM_ConfigureUi" Action="CPM_SetConfigureUiCommand"
                 Value="&quot;[#CaddyManagerExe]&quot; configure [CPM_CFG_PORT_ARG] [CPM_CFG_BIND_ARG]"
                 Before="CPM_ConfigureUi" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    <CustomAction Id="CPM_ConfigureUi"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- On a real uninstall (not a major upgrade) also stop and delete the "Caddy" service the manager created, the
         firewall rules of the "Caddy Proxy Manager" group created by readiness fixes and the event log source. -->
    <SetProperty Id="CPM_RemoveCaddyService"
                 Value="&quot;[#CaddyManagerExe]&quot; uninstall-caddy-service"
                 Before="CPM_RemoveCaddyService" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="CPM_RemoveCaddyService"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- After the service is registered and before it starts: delayed start, recovery actions, failure-actions flag. -->
    <SetProperty Id="CPM_ConfigureService"
                 Value="&quot;[#CaddyManagerExe]&quot; configure-service"
                 Before="CPM_ConfigureService" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    <CustomAction Id="CPM_ConfigureService"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- ===================================================================== wizard UI -->
    <!-- Finish page text (shown after a successful install, not after repair/uninstall). Formatted here so the port is filled in. -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Action="CPM_SetExitDialogText"
                 Value="Open http://[CPM_UI_HOST]:[CPM_FIREWALL_PORT]/ on this server (Start menu: Caddy Proxy Manager). To create the first administrator, paste the setup token from C:\ProgramData\CaddyProxyManager\setup-token.txt - show it in an elevated PowerShell with: Get-Content C:\ProgramData\CaddyProxyManager\setup-token.txt"
                 After="CostFinalize" Sequence="ui" />

    <!-- Minimal wizard without a license page, built from the WixUI dialog library (WixToolset.UI.wixext):
         WelcomeDlg → VerifyReadyDlg → ProgressDlg → ExitDialog; maintenance mode offers Repair / Remove. -->
    <UI Id="CPM_WixUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <InstallExecuteSequence>
      <Custom Action="CPM_ConfigureService" After="InstallServices" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="CPM_ConfigureUi" After="InstallFiles" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="CPM_RemoveCaddyService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
